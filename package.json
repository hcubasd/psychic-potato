		"text-fitting",
		"font-size",
		"responsive",
		"dom",
		"typography"
	],
	"license": "MIT",
	"homepage": "https://github.com/hcubasd/psychic-potato#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/hcubasd/psychic-potato"
	},
	"engines": {
		"node": ">=23.0.0 <27.0.0"
	},
	"scripts": {
		"test": "vitest --environment jsdom",
		"build": "tsc --rootDir src --outDir dist"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@tsconfig/node23": "^23.0.4",
		"jsdom": "^26.1.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	}
}